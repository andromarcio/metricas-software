        { "tipo": "R", "entidade": "Emprestimo", "atributos": ["id", "leitor", "livro", "data_prevista", "status"], "evidencia": ["REQ:RF-09"] },
        { "tipo": "R", "entidade": "Leitor", "atributos": ["cpf", "nome", "email"], "evidencia": ["REQ:RF-09"] },
        { "tipo": "R", "entidade": "Livro", "atributos": ["isbn", "titulo"], "evidencia": ["REQ:RF-09"] },
        { "tipo": "X", "entidade": "Emprestimo", "usuario": "UF3", "atributos": ["data_prevista", "dias_atraso"], "evidencia": ["REQ:RF-09 (conteúdo do e-mail)"] },
        { "tipo": "X", "entidade": "Leitor", "usuario": "UF3", "atributos": ["nome", "email"], "evidencia": ["REQ:RF-09 (destinatário e saudação)"] },
        { "tipo": "X", "entidade": "Livro", "usuario": "UF3", "atributos": ["titulo"], "evidencia": ["REQ:RF-09 (conteúdo do e-mail)"] },
        { "tipo": "E", "entidade": "Notificacao", "usuario": "UF3", "atributos": ["status_envio"], "evidencia": ["REQ:RF-09 (status devolvido pelo serviço)"], "nota": "RI-05 c: a resposta do serviço é usada (gravada)" },
        { "tipo": "W", "entidade": "Notificacao", "atributos": ["emprestimo", "data_envio", "status_envio"], "evidencia": ["REQ:RF-09 (registra a notificação)"] }
